# Шаблон конфигурации. Скопируйте в .env.dev (разработка) или .env (прод):
#   cp .env.example .env.dev
#   cp .env.example .env
#
# Порядок приоритета: системное окружение > .env.{APP_ENV} > .env
# (dotenvy не перезаписывает уже заданные переменные).

# dev (по умолчанию) или prod
APP_ENV=dev

# Строка подключения к SQLite
DATABASE_URL=sqlite:./dev_sqlite.db

# Адрес и порт привязки сервера
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Приветственное сообщение при старте.
# Значение с пробелами обязательно брать в кавычки — этого требует парсер dotenvy.
START_MESSAGE="БЕРЕГ API запущен"

# Разрешённые CORS-origin'ы через запятую.
# В dev включается permissive-режим, и переменная не обязательна.
# В prod перечислите домены фронтенда; пусто — CORS-заголовки не отдаются.
CORS_ALLOWED_ORIGINS=

# Переопределяет фильтр логирования (необязательно), напр. info,tower_http=warn
RUST_LOG=

# Токен админ-приложения (заголовок X-Admin-Token).
# Без него всё под /api/admin/* отвечает 503, а сам сайт работает как обычно.
# Сгенерировать: openssl rand -hex 24
ADMIN_TOKEN=

# Каталог фотографий авто: тот же путь используется для раздачи /images
# и для сохранения фото, загруженных из админ-API.
IMAGES_DIR=static/images

# AI-функции (генерация объявлений) через OpenRouter: https://openrouter.ai/keys
# Ключ живёт только на сервере и никогда не отдаётся клиенту.
# Пусто — эндпоинты /api/admin/ai/* отвечают 503, остальная часть работает.
OPENROUTER_API_KEY=

# Модель OpenRouter (необязательно). Пусто — openai/gpt-4o-mini:
# быстрая и дешёвая, для коротких текстов хватает.
OPENROUTER_MODEL=
