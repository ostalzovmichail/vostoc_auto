# Шаблон конфигурации. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env

# Токен бота, который выдаёт @BotFather.
TELOXIDE_TOKEN=tokenEXAMPLE

# Каталог для сохранения (по умолчанию ./data).
DATA_DIR=./data

# Уровень логирования (необязательно): info, debug, warn и т.п.
RUST_LOG=info
